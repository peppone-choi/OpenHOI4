{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifest",
  "type": "object",
  "properties": {
    "conflicts": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "depends": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Dependency"
      }
    },
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "load_after": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "name_key": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "$ref": "#/$defs/SemVer"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "name_key",
    "version",
    "engine"
  ],
  "$defs": {
    "Dependency": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    },
    "SemVer": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    }
  }
}
