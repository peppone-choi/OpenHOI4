[
  {
    "label": "fmt",
    "command": [
      "cargo",
      "fmt",
      "--check"
    ],
    "exit": 0
  },
  {
    "label": "clippy",
    "command": [
      "cargo",
      "clippy",
      "--workspace",
      "--all-targets",
      "--locked",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  {
    "label": "rust-tests",
    "command": [
      "cargo",
      "test",
      "--workspace",
      "--locked"
    ],
    "exit": 0
  }
]